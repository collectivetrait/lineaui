#!/bin/sh

npm run build
if [ $? -ne 0 ]; then
  echo "pre-commit: build failed"
  exit 1
fi

JS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.mjs')
SCSS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.scss')

exit_code=0

if [ -n "$JS_FILES" ]; then
  npx eslint $JS_FILES
  if [ $? -ne 0 ]; then
    exit_code=1
  fi
fi

if [ -n "$SCSS_FILES" ]; then
  npx stylelint $SCSS_FILES
  if [ $? -ne 0 ]; then
    exit_code=1
  fi
fi

MARGIN_TOP=$(grep -rn 'margin-top' scss/ --include='*.scss' | grep -v '// allowed exception' | grep -v 'margin-top: 0' | grep -v 'margin-top: -' | grep -v '_map.scss' | grep -v '//.*margin-top')
if [ -n "$MARGIN_TOP" ]; then
  echo ""
  echo "pre-commit: margin-top declarations found without '// allowed exception':"
  echo "$MARGIN_TOP"
  echo ""
  echo "Use margin-bottom on the preceding element, gap on the parent, or add '// allowed exception' if justified."
  exit_code=1
fi

exit $exit_code
