{
  "name": "@collectivetrait/lineaui",
  "version": "1.0.1",
  "description": "A lightweight SCSS and JavaScript component library built on BEM naming, an 8px vertical rhythm, and cascade layers.",
  "keywords": [
    "SCSS library",
    "BEM",
    "component library",
    "vertical rhythm",
    "SCSS framework",
    "UI components",
    "accessible CSS",
    "lightweight CSS",
    "cascade layers",
    "SCSS"
  ],
  "author": "Andrés Villarreal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collectivetrait/lineaui.git"
  },
  "homepage": "https://lineaui.com",
  "bugs": {
    "url": "https://github.com/collectivetrait/lineaui/issues"
  },
  "type": "module",
  "main": "dist/bundle.js",
  "style": "dist/styles.css",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "scss",
    "js",
    "config.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "humans.txt"
  ],
  "exports": {
    ".": "./dist/bundle.js",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/core.css": "./dist/core.css",
    "./dist/blocks.css": "./dist/blocks.css",
    "./dist/utilities.css": "./dist/utilities.css",
"./dist/theme-init.js": "./dist/theme-init.js",
    "./scss": "./scss/_index.scss"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "lint": "eslint && stylelint \"scss/**/*.scss\"",
    "lint:js": "eslint",
    "lint:scss": "stylelint \"scss/**/*.scss\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cssnano": "^7.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.12.0",
    "postcss": "^8.4.0",
    "sass": "^1.69.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
